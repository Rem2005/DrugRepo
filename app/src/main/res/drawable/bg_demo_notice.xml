<?xml version="1.0" encoding="utf-8"?>
<!--
    The demonstration-mode notice. Same shape as bg_card, tinted with the demo colour rather than
    the surface colour, so that a demonstration screen can never be mistaken for a field screen at
    a glance: the warning itself is the visual difference, not just its wording.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/demo_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/demo_stroke" />
    <corners android:radius="@dimen/card_radius" />
</shape>