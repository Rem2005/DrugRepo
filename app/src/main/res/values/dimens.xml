<?xml version="1.0" encoding="utf-8"?>
<!--
    Spacing and sizing. Two rules hold everywhere: 16dp screen margins, and a 48dp minimum touch
    target for anything interactive (accessibility basics, TODO.md Phase 2).

    row_gap is the space between two label/value rows. It is separate from item_gap because a list
    of rows needs a tight, even rhythm, while item_gap is the gap between unrelated blocks.
-->
<resources>
    <dimen name="screen_margin">16dp</dimen>
    <dimen name="section_gap">24dp</dimen>
    <dimen name="item_gap">8dp</dimen>
    <dimen name="row_gap">2dp</dimen>
    <dimen name="card_gap">12dp</dimen>

    <dimen name="card_radius">10dp</dimen>
    <dimen name="card_padding">16dp</dimen>
    <dimen name="button_radius">8dp</dimen>

    <dimen name="touch_target">48dp</dimen>
    <dimen name="button_height">52dp</dimen>
    <dimen name="swatch_size">44dp</dimen>
</resources>
