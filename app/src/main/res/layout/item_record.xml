<?xml version="1.0" encoding="utf-8"?>
<!--
    One record card, inflated by RecordsActivity. The whole card is the click target, so the
    touch target is the full row rather than the text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/touch_target">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRecordTitle"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecordTag"
            style="@style/Text.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/demo_bg"
            android:text="MOCK"
            android:textColor="@color/demo_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRecordOfficer"
        style="@style/Text.Support"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvRecordTime"
        style="@style/Text.Support"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvRecordResult"
        style="@style/Text.ResultValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="18sp" />

</LinearLayout>
