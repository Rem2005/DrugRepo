<?xml version="1.0" encoding="utf-8"?>
<!--
    Home. ScrollView because the recent-tests section is unbounded in principle; the officer
    path (New Field Test) stays above the fold.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Text.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DrugRepo" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="DIGITAL FIELD DRUG TESTING" />

        <TextView
            style="@style/Text.Support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:text="Capture and analyze a field test card on this device. Results are presumptive and always require laboratory confirmation." />

        <LinearLayout
            style="@style/Widget.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap">

            <TextView
                style="@style/Text.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Field Test"
                android:textSize="18sp" />

            <TextView
                style="@style/Text.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap"
                android:layout_marginBottom="16dp"
                android:text="Verify the officer badge, capture the test card, and analyze the reaction on device." />

            <Button
                android:id="@+id/btnNewTest"
                style="@style/Widget.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Start New Test" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecentLabel"
            style="@style/Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:layout_marginBottom="12dp"
            android:text="RECENT TESTS" />

        <!--
            Populated by HomeActivity from the existing DAO read; the container itself is empty
            in XML on purpose so the section can be hidden when there is nothing to show.
        -->
        <LinearLayout
            android:id="@+id/recentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnTestRecords"
            style="@style/Widget.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:text="View All Records" />

        <TextView
            style="@style/Text.Support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:text="Version 0.1.0-prototype — offline, on-device, presumptive results only." />

    </LinearLayout>
</ScrollView>
